      "sample_text",
      "smoke_extracts",
      "qa_reference",
      "source_sample_id",
      "sample entity markers",
      "raw KB rows",
      "raw prompt body",
      "source_register",
      "overlay JSON"
    ]
  },
  "gates": [
    "no_http_403",
    "no_live_fallback",
    "no_validator_pseudo_success",
    "validator_gate_evidence.rows_match=true",
    "validator_gate_evidence.row_diffs=[]",
    "story_fact_frame_binding_evidence.present",
    "story_fact_frame_binding_evidence.stale_binding_detected=false",
    "story_fact_frame_binding_evidence.missing_source_facts=[]",
    "story_fact_frame_binding_evidence.forbidden_fact_hits=[]",
    "prompt_text_boundary_evidence.prompt_text_boundary_passed=true",
    "runner_assert_failures=[]"
  ],
