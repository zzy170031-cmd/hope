      "reason": "coder-specialized models are excluded"
    }
  ],
  "output_contract": {
    "contract_kind": "structural_safety_contract_not_creative_style_template",
    "required_fields": [
      "provider",
      "model",
      "script_goal",
      "scene_type",
      "duration",
      "accepted_snapshot_hash",
      "story_fact_frame_hash",
      "source_text_hash",
      "rows[]",
      "rows[].person",
      "rows[].visual_description",
      "rows[].character_action",
      "rows[].camera_movement",
      "rows[].prompt_text",
      "source_fact_refs",
      "required_fact_refs",
      "forbidden_fact_refs",
      "prompt_text_boundary",
      "no_fallback_evidence",
      "validator_status",
      "hard_gate_failures[]",
      "quality_warnings[]",
      "normalizer_actions[]",
      "creative_freedom_preserved",
      "template_overconstraint_risk",
      "sample_leakage_risk",
      "source_fact_binding_status",
      "prompt_boundary_status",
      "fallback_status"
    ],
    "same_contract_for_all_models": true,
    "raw_prompt_redacted": true,
    "raw_provider_response_redacted": true
  },
  "creative_freedom_protection": {
    "fixed_row_count": false,
    "fixed_three_rows": false,
    "fixed_sentence_style": false,
    "fixed_action_tempo": false,
    "fixed_camera_style": false,
    "sample_structure_template": false,
    "model_style_variance_allowed": true,
    "natural_expression_variance_allowed": true,
    "quality_review_is_not_hard_gate": true
  },
  "failure_classification_policy": {
    "runner_stage_order": [
      "provider_retry_exhausted_hard_fail",
      "qa_hard_fail_evidence_missing",
      "model_not_found",
      "entitlement",
      "quota",
      "http_403",
      "invalid_parameter",
      "script_goal_hard_gate_fail",
      "validator_hard_gate_fail",
      "prompt_text_boundary",
      "story_fact_frame_or_accepted_snapshot_hard_gate_fail",
      "fallback_or_provider_hard_gate_fail",
      "contract_hard_gate_fail"
    ],
    "alias_compatibility_missing_hard_fail_evidence_stage": "alias_compatibility_reference_not_required_gate",
    "provider_unavailable_categories": [
      "model_unavailable",
      "model_not_found",
      "entitlement",
      "quota",
      "http_403",
      "invalid_parameter"
    ],
    "qa_hard_fail_evidence_missing_is_not_prompt_text_boundary": true,
    "validator_hard_gate_fail_is_not_prompt_text_boundary": true,
    "quality_warning_only_blocks_gate": false,
    "hard_gate_failure_can_be_downgraded": false
  },
  "provider_availability_probe_contract": {
    "artifact_path_pattern": "target/qa-live3-provider-probe/<timestamp>/qwen-text-model-availability.json",
    "probe_scope": "required_text_gate_models_only",
    "minimum_probe_per_model": 1,
    "raw_values_redacted": true,
    "raw_env_redacted": true,
    "raw_prompt_redacted": true,
    "raw_provider_response_redacted": true,
    "required_result_fields": [
      "model",
      "http_status",
      "error_category",
      "error_code",
      "choices_present",
      "callable"
    ],
    "unavailable_error_categories": [
      "model_not_found",
      "entitlement",
      "quota",
      "http_403",
      "invalid_parameter",
      "provider_retry_exhausted",
      "network_or_transport",
      "unknown"
    ],
    "callable_models_enter_live3": true,
    "unavailable_models_do_not_count_as_live3_required_pass": true,
    "callable_required_models_below_five_is_blocker": true
  },
  "hard_gate_vs_quality_warning_policy": {
    "hard_gate_failures": [
      "source_fact_binding_fail",
      "forbidden_drift",
      "prompt_text_pollution",
      "fallback_or_local_candidate",
      "provider_model_mismatch",
      "provider_retry_exhausted_hard_fail",
      "qa_hard_fail_evidence_missing",
      "model_unavailable",
      "model_not_found",
      "entitlement",
      "quota",
      "http_403",
      "invalid_parameter",
      "validator_hard_gate_fail",
      "scene_type_or_duration_override",
      "rows_schema_not_executable",
      "rows_match_false",
      "story_fact_frame_or_accepted_snapshot_missing_or_stale",
      "cleanup_failure"
    ],
    "quality_warnings": [
      "template_like_expression",
      "weak_rhythm",
      "low_visual_specificity",
      "plain_prompt_language",
      "weak_emotion_expression",
      "positive_scene_type_difference_too_small"
    ],
    "quality_warning_only_blocks_gate": false,
    "hard_gate_failure_can_be_downgraded": false
  },
  "normalizer_boundary": {
    "allowed_actions": [
      "field_name_normalization",
      "json_or_row_shape_normalization",
      "markdown_json_unwrap",
      "visual_action_camera_column_split",
      "source_fact_ref_annotation",
      "forbidden_fact_ref_annotation",
      "normalize_notes",
      "uncertainty_marked_for_validator"
    ],
    "forbidden_actions": [
      "add_user_source_facts",
      "invent_character_prop_place_worldview",
      "use_21_or_27_samples_as_runtime_content",
      "rewrite_user_facts_for_validator",
      "force_fixed_template_style",
      "rewrite_prompt_text_as_sample_style",
      "delete_hard_gate_failure_evidence",
      "present_fallback_as_live_provider_output"
    ]
  },
  "sample_reference_boundary": {
    "runtime_consumes_21_sample_text": false,
    "runtime_consumes_27_sample_text": false,
    "prompt_text_forbidden_markers": [
      "sample_text",
      "smoke_extracts",
      "qa_reference",
      "source_sample_id",
      "sample_character",
      "sample_prop",
      "sample_place",
      "raw_kb_rows",
      "source_register",
      "overlay_json"
    ]
  },
