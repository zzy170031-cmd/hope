{
  "name": "hope-web-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "targeted": "node tests/qa/web-formal403-runner.mjs --targeted",
    "full16": "node tests/qa/web-formal403-runner.mjs --full16",
    "formal403:plan-only": "node tests/qa/web-formal403-runner.mjs --formal403 --plan-only",
    "formal403:live": "node tests/qa/web-formal403-runner.mjs --formal403"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.8.3",
    "vite": "^6.1.0",
    "vitest": "^3.2.4"
  }
}
